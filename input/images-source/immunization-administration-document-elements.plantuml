@startuml
skinparam shadowing false
skinparam rectangle {
    roundCorner 10
}

skinparam linetype straight
skinparam defaultFontSize 12

left to right direction


rectangle "[[StructureDefinition-ch-vacd-document-immunization-administration.html Bundle: Immunization Administration Document]]" as document #Orange {

    rectangle "[[StructureDefinition-ch-vacd-composition-immunization-administration.html Entry: Composition]]" as composition #Lightblue  {
        together {
            rectangle author
            rectangle subject
        }

        together {
            card "Section: Immunization Administration" #LightGreen {
                card entry as entry1.1
                card entry as entry1.2
            }
            card "Section: Medical Problems" #LightGreen {
                card entry as entry2.1
            }
            rectangle "Section: Past Illnesses" #LightGreen {
                card entry as entry3.1
            }
            card "Section: Allergies and Intolerances" #LightGreen {
                card entry as entry4.1
            }
            card "Section: Laboratory Serology" #LightGreen {
                card entry as entry5.1
            }
            card "Section: Annotation" #LightGreen {
                card "text"
            }
        }
    }

    rectangle "entries" as entries {
        together {
            rectangle "[[http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-patient-epr Entry: Patient]]" as patient #ec4d4dff {
            }

            rectangle "[[http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-practitionerrole-epr Entry: PractitionerRole]]" as practitionerrole #ec4d4dff {
            }


            rectangle "[[StructureDefinition-ch-vacd-immunization.html Entry: Immunization]]" as immunization1 #ec4d4dff {
            }

            rectangle "[[StructureDefinition-ch-vacd-basic-immunization.html Entry: BasicImmunization]]" as basicimmunization #ec4d4dff {
            }
            rectangle "[[StructureDefinition-ch-vacd-medical-problems.html Entry: MedicalProblem]]" as medicalproblem #ec4d4dff {
            }
            rectangle "[[StructureDefinition-ch-vacd-pastillnesses.html Entry: PastIllness]]" as pastillness #ec4d4dff {
            }
            rectangle "[[StructureDefinition-ch-vacd-allergyintolerances.html Entry: AllergyIntolerance]]" as allergyintolerance #ec4d4dff {
            }
            rectangle "[[StructureDefinition-ch-vacd-laboratory-serology.html Entry: LaborAndSerology]]" as laborandserology #ec4d4dff {
            }

        }
        together {
            rectangle "[[http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-practitioner-epr Entry: Practitioner]]" as practitioner #ec4d4dff {
            }
            rectangle "[[http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-organization-epr Entry: Organization]]" as organization #ec4d4dff {
            }

            rectangle "[[StructureDefinition-ch-vacd-medication-for-immunization.html Entry: Medication For Immunization]]" as mediforimmun #ec4d4dff {
            }
        }
    }
}


subject "Reference"..> patient
author "Reference"..> practitionerrole
practitionerrole ..>"organization: Reference" organization
practitionerrole ..>"practitioner: Reference" practitioner

entry1.1 "Reference"..> immunization1
immunization1 ..>"extension: Reference" mediforimmun
entry1.2 "Reference"..> basicimmunization

entry2.1 "Reference"..> medicalproblem

entry3.1 "Reference"..> pastillness

entry4.1 "Reference"..> allergyintolerance

entry5.1 "Reference"..> laborandserology


@enduml